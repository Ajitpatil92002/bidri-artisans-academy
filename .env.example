# Copy to .env.local. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (docker-compose.yml)
DATABASE_URL=postgresql://bidri:bidri_local@localhost:5432/bidri
# Production only: Neon's direct URL, used for migrations. DATABASE_URL is its pooled URL.
# DIRECT_URL=

# Login: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin account created by the seed
ADMIN_EMAIL=admin@bidriart.test
ADMIN_PASSWORD=

# Razorpay. Use test keys until launch.
# With RAZORPAY_MOCK=true in development, checkout uses a local stand-in, so no keys are needed.
RAZORPAY_MOCK=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Image storage: Cloudflare R2. Leave S3_BUCKET empty to save uploads in public/uploads (development).
# S3_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL is the bucket's public address, such as https://images.bidriart.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email. Set RESEND_API_KEY in production. Without it, development saves emails to .dev-emails/.
RESEND_API_KEY=
EMAIL_FROM=Bidri Craft <orders@bidriart.com>
ADMIN_NOTIFY_EMAIL=admin@bidriart.test

# Protects /api/cron/release-stock
CRON_SECRET=
